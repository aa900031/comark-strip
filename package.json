{
	"name": "comark-strip",
	"type": "module",
	"version": "0.0.0",
	"packageManager": "pnpm@11.24.0",
	"author": "zhong666 <hi@zhong666.me>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/aa900031/comark-strip"
	},
	"keywords": [
		"comark",
		"comark-plugin",
		"markdown"
	],
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsdown",
		"release": "release-it",
		"lint": "eslint .",
		"test": "vitest run",
		"bench": "vitest bench --run",
		"typecheck": "tsc -b"
	},
	"peerDependencies": {
		"comark": ">=0.6.0"
	},
	"devDependencies": {
		"@aa900031/eslint-config": "^8.0.3",
		"@aa900031/release-it-config": "^1.0.0",
		"@aa900031/tsdown-config": "^0.2.2",
		"@codspeed/vitest-plugin": "^5.7.1",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.13.3",
		"@vitest/coverage-istanbul": "^4.1.11",
		"comark": "^0.6.2",
		"eslint": "^10.9.1",
		"release-it": "^20.2.1",
		"tsdown": "^0.22.0",
		"typescript": "~5.9.3",
		"vitest": "^4.1.11"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"import": {
					"types": "./dist/index.d.ts",
					"default": "./dist/index.js"
				},
				"require": {
					"types": "./dist/index.d.cts",
					"default": "./dist/index.cjs"
				}
			},
			"./package.json": "./package.json"
		}
	}
}
